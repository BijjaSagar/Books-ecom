# Bookory Admin Dashboard - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# APPLICATION SETTINGS
# ============================================
APP_NAME=Bookory
APP_ENV=production
APP_DEBUG=false
APP_URL=https://bookory.local
APP_TIMEZONE=UTC

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u618910819_bookshelf_db
DB_USERNAME=root
DB_PASSWORD=your_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# For SQLite (if using)
# DB_CONNECTION=sqlite
# DB_PATH=/path/to/bookshelf.db

# ============================================
# PAYPAL CONFIGURATION
# ============================================
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
PAYPAL_SIGNATURE=your_paypal_signature

# ============================================
# RAZORPAY CONFIGURATION
# ============================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ============================================
# EMAIL CONFIGURATION
# ============================================
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=reports@bookory.local
MAIL_FROM_NAME="Bookory Reports"

# Admin email for reports
ADMIN_EMAIL=admin@bookory.local

# Report frequency: daily or weekly
REPORT_FREQUENCY=daily

# Enable/disable email reports
ENABLE_EMAIL_REPORTS=true

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=/uploads/bulk
ALLOWED_EXTENSIONS=csv,xlsx,xls

# ============================================
# SESSION CONFIGURATION
# ============================================
SESSION_LIFETIME=120
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ============================================
# CACHE CONFIGURATION
# ============================================
CACHE_DRIVER=file
CACHE_TTL=3600

# ============================================
# SECURITY
# ============================================
CSRF_PROTECTION=true
RATE_LIMIT=60
RATE_LIMIT_WINDOW=60

# ============================================
# AWS S3 (Optional - for image storage)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=bookory-images

# ============================================
# LOGGING
# ============================================
LOG_CHANNEL=stack
LOG_LEVEL=warning
LOG_PATH=/var/log/bookory/

# ============================================
# API KEYS (For Third-party services)
# ============================================
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
GOOGLE_ANALYTICS_ID=
SENTRY_DSN=

# ============================================
# DEVELOPMENT SETTINGS (Set to false in production)
# ============================================
DISPLAY_ERRORS=false
ERROR_REPORTING=0
DEVELOPMENT_MODE=false
