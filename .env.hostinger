# ============================================
# BOOKORY HOSTINGER PRODUCTION CONFIGURATION
# ============================================
# This is a Hostinger-specific configuration template
# Copy this to .env and fill in your actual values from hPanel
# ============================================

# ============================================
# APPLICATION SETTINGS
# ============================================
APP_NAME=Bookory
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_TIMEZONE=UTC

# ============================================
# HOSTINGER DATABASE CONFIGURATION
# ============================================
# Get these values from hPanel → Hosting → MySQL Databases
# 1. Click "Manage" next to your database
# 2. Copy the exact values shown there

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306

# Your Hostinger database name (e.g., u618910819_bookshelf_db)
DB_DATABASE=u618910819_bookshelf_db

# Your Hostinger MySQL username (e.g., u618910819_books)
DB_USERNAME=u618910819_books

# Your MySQL password from hPanel
DB_PASSWORD=YOUR_MYSQL_PASSWORD_HERE

DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ============================================
# HOSTINGER EMAIL CONFIGURATION
# ============================================
# For Hostinger email, use these settings:
# https://support.hostinger.com/en/articles/1583408-how-to-configure-smtp

MAIL_DRIVER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl

# Your Hostinger email address (e.g., noreply@yourdomain.com)
MAIL_USERNAME=noreply@yourdomain.com

# Your email password from hPanel → Email Accounts
MAIL_PASSWORD=YOUR_EMAIL_PASSWORD_HERE

MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="Bookory Online Bookstore"

# Admin email for receiving reports
ADMIN_EMAIL=admin@yourdomain.com

# Email reports configuration
REPORT_FREQUENCY=daily
ENABLE_EMAIL_REPORTS=true

# ============================================
# PAYPAL CONFIGURATION (PRODUCTION)
# ============================================
# Get your live credentials from PayPal Developer Dashboard
# https://developer.paypal.com/dashboard/

PAYPAL_MODE=live
PAYPAL_CLIENT_ID=YOUR_PAYPAL_LIVE_CLIENT_ID
PAYPAL_SECRET=YOUR_PAYPAL_LIVE_SECRET
PAYPAL_SIGNATURE=

# For testing, switch to sandbox:
# PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID
# PAYPAL_SECRET=YOUR_SANDBOX_SECRET

# ============================================
# STRIPE CONFIGURATION (PRODUCTION)
# ============================================
# Get your live keys from Stripe Dashboard
# https://dashboard.stripe.com/apikeys

STRIPE_PUBLIC_KEY=pk_live_YOUR_PUBLIC_KEY
STRIPE_SECRET_KEY=sk_live_YOUR_SECRET_KEY

# For testing, use test keys:
# STRIPE_PUBLIC_KEY=pk_test_YOUR_PUBLIC_KEY
# STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY

# ============================================
# RAZORPAY CONFIGURATION (For India)
# ============================================
# Get your live keys from Razorpay Dashboard
# https://dashboard.razorpay.com/app/keys

RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET

# For testing:
# RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
# RAZORPAY_KEY_SECRET=YOUR_TEST_SECRET

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
# Max upload size in bytes (10MB = 10485760)
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=/uploads/bulk
ALLOWED_EXTENSIONS=csv,xlsx,xls

# Max image size in bytes (5MB = 5242880)
MAX_IMAGE_SIZE=5242880
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp

# ============================================
# SESSION CONFIGURATION (Production Secure)
# ============================================
SESSION_LIFETIME=120
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_NAME=BOOKORY_SESSION

# ============================================
# SECURITY SETTINGS (Production)
# ============================================
CSRF_PROTECTION=true
RATE_LIMIT=60
RATE_LIMIT_WINDOW=60
PASSWORD_MIN_LENGTH=8
ENABLE_2FA=false

# Security headers
ENABLE_HSTS=true
HSTS_MAX_AGE=31536000
ENABLE_CSP=true

# ============================================
# CACHE CONFIGURATION
# ============================================
CACHE_DRIVER=file
CACHE_TTL=3600
ENABLE_QUERY_CACHE=true
ENABLE_PAGE_CACHE=false

# ============================================
# LOGGING (Production)
# ============================================
LOG_CHANNEL=file
LOG_LEVEL=error
LOG_PATH=/home/YOUR_USERNAME/logs/
ENABLE_ERROR_LOGGING=true
ENABLE_ACCESS_LOGGING=false

# ============================================
# PERFORMANCE SETTINGS
# ============================================
ENABLE_GZIP=true
ENABLE_MINIFICATION=false
CDN_URL=
ENABLE_LAZY_LOADING=true

# ============================================
# BUSINESS SETTINGS
# ============================================
STORE_NAME=Bookory
STORE_CURRENCY=USD
STORE_CURRENCY_SYMBOL=$
TAX_RATE=0.00
FREE_SHIPPING_THRESHOLD=50.00
DEFAULT_SHIPPING_COST=5.99

# Inventory alerts
LOW_STOCK_THRESHOLD=10
OUT_OF_STOCK_THRESHOLD=0

# ============================================
# ANALYTICS & TRACKING (Optional)
# ============================================
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
FACEBOOK_PIXEL_ID=
SENTRY_DSN=

# ============================================
# PRODUCTION SETTINGS
# ============================================
DISPLAY_ERRORS=false
ERROR_REPORTING=0
DEVELOPMENT_MODE=false
DEBUG_SQL=false
ENABLE_PROFILING=false

# ============================================
# MAINTENANCE MODE
# ============================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="We're currently performing scheduled maintenance. Please check back soon!"
MAINTENANCE_ALLOWED_IPS=127.0.0.1

# ============================================
# BACKUP CONFIGURATION
# ============================================
ENABLE_AUTO_BACKUP=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/home/YOUR_USERNAME/backups/

# ============================================
# CRON JOB SETTINGS
# ============================================
ENABLE_CRON_JOBS=true
CRON_SECRET_KEY=CHANGE_THIS_TO_RANDOM_STRING

# ============================================
# API SETTINGS
# ============================================
API_ENABLED=true
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=3600
API_KEY=YOUR_API_KEY_FOR_EXTERNAL_ACCESS

# ============================================
# AWS S3 (Optional - if using cloud storage)
# ============================================
AWS_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=bookory-images
AWS_URL=
